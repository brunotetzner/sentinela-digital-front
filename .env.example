# Base da API do Sentinela Digital. Sem barra no final.
VITE_API_URL=http://localhost:3000

# Web API key do projeto Firebase, usada para trocar o custom token do login por um ID token.
# É o mesmo valor de FIREBASE_API_KEY no .env do backend. Não é segredo: toda variável VITE_*
# vai para o bundle, e essa chave é feita para viver no cliente.
VITE_FIREBASE_API_KEY=
